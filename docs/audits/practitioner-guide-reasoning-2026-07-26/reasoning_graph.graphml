    <node id="P0001">
      <data key="d0">paragraph</data>
      <data key="d1"></data>
      <data key="d2">\hypersetup{pageanchor=false} \begin{titlepage} \thispagestyle{empty} \vspace*{0.55in} \noindent{\color{guideblue}\rule{\textwidth}{1.2pt}\par} \vspace{1.15em} {\Huge\bfseries Transport Network Welfare\par} \vspace{0.55em} {\Large Theory, Computation, and Practice with\par} \vspace{0.12em} {\Large\ttfamily TransportNetworkWelfare.jl\par} \vspace{1.75em} {\large Treb Allen \quad Simon Fuchs \quad Woan Foong Wong\par} \vspace{0.4em} {\color{black!60}Practitioner guide for package API v0.1.0, July 2026\par}</data>
      <data key="d3">exposition</data>
      <data key="d4">docs/practitioner-guide/main.tex</data>
      <data key="d5">9</data>
      <data key="d6">23</data>
    </node>
    <node id="S0001">
      <data key="d0">sentence</data>
      <data key="d1"></data>
      <data key="d2">\hypersetup{pageanchor=false} \begin{titlepage} \thispagestyle{empty} \vspace*{0.55in} \noindent{\color{guideblue}\rule{\textwidth}{1.2pt}\par} \vspace{1.15em} {\Huge\bfseries Transport Network Welfare\par} \vspace{0.55em} {\Large Theory, Computation, and Practice with\par} \vspace{0.12em} {\Large\ttfamily TransportNetworkWelfare.jl\par} \vspace{1.75em} {\large Treb Allen \quad Simon Fuchs \quad Woan Foong Wong\par} \vspace{0.4em} {\color{black!60}Practitioner guide for package API v0.1.0, July 2026\par}</data>
      <data key="d3">exposition</data>
      <data key="d4">docs/practitioner-guide/main.tex</data>
      <data key="d5">9</data>
      <data key="d6">23</data>
